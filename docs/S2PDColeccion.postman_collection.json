{
  "info": {
    "_postman_id": "d3b908d4-ab40-4ddb-b356-b6217d34e724",
    "name": "S2PDColeccion",
    "description": "Pruebas de la API del Seguimiento 2 (SGCAE). Antes de ejecutar, pegue en la variable areaId un Id de la tabla Areas (SELECT Id, Name FROM Areas). Ejecute las carpetas en orden: los demás IDs se guardan solos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Empleados (RF-01)",
      "item": [
        {
          "name": "Registrar empleado",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/employees",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "employees"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"documentNumber\": \"{{documentNumber}}\",\n  \"firstName\": \"Ana María\",\n  \"lastName\": \"Gómez Ruiz\",\n  \"email\": \"ana.{{$timestamp}}@empresa.com\",\n  \"position\": \"Auxiliar de bodega\",\n  \"areaId\": \"{{areaId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Antes de ejecutar, pegue en la variable areaId de la colección un Id de la tabla Areas (SELECT Id, Name FROM Areas)."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"documentNumber\", \"10\" + Math.floor(10000000 + Math.random() * 89999999));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"employeeId\", pm.response.json().data);"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar empleados (paginado)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/employees?pageNumber=1&pageSize=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "employees"
              ],
              "query": [
                {
                  "key": "pageNumber",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "10"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Actualizar empleado",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/employees",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "employees"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{employeeId}}\",\n  \"firstName\": \"Ana María\",\n  \"lastName\": \"Gómez Ruiz\",\n  \"email\": \"ana.act.{{$timestamp}}@empresa.com\",\n  \"position\": \"Coordinadora de bodega\",\n  \"areaId\": \"{{areaId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Puntos de acceso (RF-06)",
      "item": [
        {
          "name": "Registrar punto de acceso",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/access-points",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "access-points"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bodega de químicos {{$randomInt}}\",\n  \"type\": 4,\n  \"isEnabled\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "type: 1 Recepción, 2 Parqueadero, 3 Bodega, 4 Área restringida"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar puntos habilitados",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/access-points?isEnabled=true",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "access-points"
              ],
              "query": [
                {
                  "key": "isEnabled",
                  "value": "true"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Todos están habilitados\", () => pm.response.json().data.items.forEach(p => pm.expect(p.isEnabled).to.eql(true)));",
                  "const first = pm.response.json().data.items[0];",
                  "if (first) { pm.collectionVariables.set(\"accessPointId\", first.id); }"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Credenciales (RF-02)",
      "item": [
        {
          "name": "Asignar credencial",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/credentials",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "credentials"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{credentialCode}}\",\n  \"employeeId\": \"{{employeeId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"credentialCode\", \"EMP-\" + Math.floor(1000 + Math.random() * 9000));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar estado de la credencial",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/credentials/{{credentialCode}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "credentials",
                "{{credentialCode}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Está vigente\", () => pm.expect(pm.response.json().data.status).to.eql(\"Active\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Registro de accesos (RF-03)",
      "item": [
        {
          "name": "Acceso autorizado",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/access",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "access"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"credentialCode\": \"{{credentialCode}}\",\n  \"accessPointId\": \"{{accessPointId}}\",\n  \"movementType\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Acceso Authorized\", () => pm.expect(pm.response.json().data.result).to.eql(\"Authorized\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Acceso rechazado",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/access",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "access"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"credentialCode\": \"NO-EXISTE-999\",\n  \"accessPointId\": \"{{accessPointId}}\",\n  \"movementType\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Acceso Rejected\", () => pm.expect(pm.response.json().data.result).to.eql(\"Rejected\"));",
                  "pm.test(\"Motivo correcto\", () => pm.expect(pm.response.json().data.rejectionReason).to.include(\"no está registrada\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. Historial de accesos (RF-04)",
      "item": [
        {
          "name": "Historial de accesos por empleado",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/access/history?employeeId={{employeeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "access",
                "history"
              ],
              "query": [
                {
                  "key": "employeeId",
                  "value": "{{employeeId}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Todos son del empleado\", () => pm.response.json().data.items.forEach(i => pm.expect(i.employeeId).to.eql(pm.collectionVariables.get(\"employeeId\"))));"
                ]
              }
            }
          ]
        }
      ]
    },
