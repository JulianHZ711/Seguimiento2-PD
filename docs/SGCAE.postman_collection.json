              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "access-points"
              ],
              "query": [
                {
                  "key": "isEnabled",
                  "value": "true"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Todos están habilitados\", () => pm.response.json().data.items.forEach(p => pm.expect(p.isEnabled).to.eql(true)));"
                ]
              }
