    {
      "name": "2. Puntos de acceso (RF-06)",
      "item": [
        {
          "name": "Consultar puntos de acceso",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/access-points?pageNumber=1&pageSize=50",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "access-points"
              ],
              "query": [
                {
                  "key": "pageNumber",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "50"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "const items = pm.response.json().data.items;",
                  "const enabled = items.find(p => p.isEnabled);",
                  "const disabled = items.find(p => !p.isEnabled);",
                  "if (enabled) { pm.collectionVariables.set(\"accessPointId\", enabled.id); }",
                  "if (disabled) { pm.collectionVariables.set(\"disabledPointId\", disabled.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar puntos habilitados",
          "request": {
            "method": "GET",
            "header": [],
