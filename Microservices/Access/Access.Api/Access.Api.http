@Access.Api_HostAddress = http://localhost:5296

# Copie aquí los IDs para probar las peticiones.
# areaId: consúltelo en SQL Server con  SELECT Id, Name FROM Areas
@areaId = 00000000-0000-0000-0000-000000000000
@employeeId = 00000000-0000-0000-0000-000000000000
@accessPointId = 00000000-0000-0000-0000-000000000000
@credentialCode = EMP-0001

### Documento OpenAPI con todos los endpoints de la API
GET {{Access.Api_HostAddress}}/openapi/v1.json
Accept: application/json

### RF-01: Registrar empleado
POST {{Access.Api_HostAddress}}/api/employees
Content-Type: application/json

{
  "documentNumber": "1036123456",
  "firstName": "Ana María",
  "lastName": "Gómez Ruiz",
  "email": "ana.gomez@empresa.com",
  "position": "Auxiliar de bodega",
  "areaId": "{{areaId}}"
}

### RF-01: Consultar empleados (paginado)
GET {{Access.Api_HostAddress}}/api/employees?pageNumber=1&pageSize=10
Accept: application/json

### RF-01: Consultar empleado por ID
GET {{Access.Api_HostAddress}}/api/employees/{{employeeId}}
Accept: application/json

### RF-01: Actualizar empleado
PUT {{Access.Api_HostAddress}}/api/employees
Content-Type: application/json

{
  "id": "{{employeeId}}",
  "firstName": "Ana María",
  "lastName": "Gómez Ruiz",
  "email": "ana.gomez@empresa.com",
  "position": "Coordinadora de bodega",
  "areaId": "{{areaId}}"
}

### RF-01: Desactivar empleado
PATCH {{Access.Api_HostAddress}}/api/employees/{{employeeId}}/deactivate
Accept: application/json

### RF-06: Registrar punto de acceso (type: 1 Recepción, 2 Parqueadero, 3 Bodega, 4 Área restringida)
POST {{Access.Api_HostAddress}}/api/access-points
Content-Type: application/json

{
  "name": "Bodega de químicos",
  "type": 4,
  "isEnabled": true
}

### RF-06: Consultar puntos de acceso
GET {{Access.Api_HostAddress}}/api/access-points?pageNumber=1&pageSize=10
Accept: application/json

### RF-06: Consultar solo puntos habilitados
GET {{Access.Api_HostAddress}}/api/access-points?isEnabled=true
Accept: application/json

### RF-06: Consultar punto de acceso por ID
GET {{Access.Api_HostAddress}}/api/access-points/{{accessPointId}}
Accept: application/json

### RF-02: Asignar credencial
POST {{Access.Api_HostAddress}}/api/credentials
Content-Type: application/json

{
  "code": "{{credentialCode}}",
  "employeeId": "{{employeeId}}"
}

### RF-02: Consultar estado de una credencial
GET {{Access.Api_HostAddress}}/api/credentials/{{credentialCode}}
Accept: application/json

### RF-02: Bloquear credencial
PATCH {{Access.Api_HostAddress}}/api/credentials/{{credentialCode}}/block
Accept: application/json

### RF-02: Revocar credencial
PATCH {{Access.Api_HostAddress}}/api/credentials/{{credentialCode}}/revoke
Accept: application/json

### RF-03: Registrar entrada (movementType: 1 Entrada, 2 Salida)
POST {{Access.Api_HostAddress}}/api/access
Content-Type: application/json

{
  "credentialCode": "{{credentialCode}}",
  "accessPointId": "{{accessPointId}}",
  "movementType": 1
}

### RF-03: Registrar salida
POST {{Access.Api_HostAddress}}/api/access
Content-Type: application/json

{
  "credentialCode": "{{credentialCode}}",
  "accessPointId": "{{accessPointId}}",
  "movementType": 2
}

### RF-03: Credencial inexistente (queda registrado como rechazado)
POST {{Access.Api_HostAddress}}/api/access
Content-Type: application/json

{
  "credentialCode": "NO-EXISTE-999",
  "accessPointId": "{{accessPointId}}",
  "movementType": 1
}

### RF-04: Historial (paginado)
GET {{Access.Api_HostAddress}}/api/access/history?pageNumber=1&pageSize=10
Accept: application/json

### RF-04: Historial por empleado
GET {{Access.Api_HostAddress}}/api/access/history?employeeId={{employeeId}}
Accept: application/json

### RF-04: Historial por rango de fechas (UTC)
GET {{Access.Api_HostAddress}}/api/access/history?from=2026-01-01&to=2026-12-31
Accept: application/json

### RF-04: Historial por punto de acceso
GET {{Access.Api_HostAddress}}/api/access/history?accessPointId={{accessPointId}}
Accept: application/json

### RF-04: Historial por resultado de validación
GET {{Access.Api_HostAddress}}/api/access/history?result=Rejected
Accept: application/json

###
